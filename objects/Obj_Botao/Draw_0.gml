//Se desenhar
draw_self()

//Selecionando a font
draw_set_font(Fn_Botao)

//Centraliza o desenho
draw_set_halign(fa_center)

//Centraliza o desenho
draw_set_valign(fa_center)

//Desenhando o texto da escolha
draw_text(x,y,texto)

//Resetando a font
draw_set_font(-1)

//Resetando o desenho
draw_set_halign(-1)